# TfL Unified API (browser + server)
TFL_API_KEY=

# Bus Open Data Service (server only) — England (+ some Wales fringe)
BODS_API_KEY=
# Optional override; default covers England/Wales (-6.5,49.8,2.0,56.0)
# BODS_BOUNDING_BOX=-6.5,49.8,2.0,56.0
# Map watchlist plates to operator fleet ids when VehicleRef is not the plate.
# Built-in: BK63YWT→4931 (NXWM), ML22XKX→35904 (First Leeds).
# BODS_REG_ALIASES=BK63YWT:4931,ML22XKX:35904
# Cardiff/Wales/Scotland gaps fall back to bustimes.org live positions.
# Glasgow & Manchester still need plates before they can be tracked.

# Supabase audit (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
